<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
        <ApplicationIcon>Resources\app.ico</ApplicationIcon>
        <Version>1.5.20</Version>
        <AssemblyVersion>1.5.20.0</AssemblyVersion>
        <FileVersion>1.5.20.0</FileVersion>
        <InformationalVersion>1.2.44</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\SHARED\Book\**\*.cs"
                 Link="Shared\Book\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\SHARED\Flags\Flags.cs"
                 Link="Shared\Flags\Flags.cs" />
        <Compile Include="..\SHARED\NeoUI\NeoThemePalette.cs"
                 Link="Shared\NeoUI\NeoThemePalette.cs" />
        <Compile Include="..\SHARED\NeoUI\NeoAssetPaths.cs"
                 Link="Shared\NeoUI\NeoAssetPaths.cs" />
        <Compile Include="..\SHARED\NeoUI\NeoAssetService.cs"
                 Link="Shared\NeoUI\NeoAssetService.cs" />
        <Compile Include="..\SHARED\NeoUI\NeoContextMenu.cs"
                 Link="Shared\NeoUI\NeoContextMenu.cs" />
        <Compile Include="..\SHARED\NeoUI\NeoLanguageMenuBuilder.cs"
                 Link="Shared\NeoUI\NeoLanguageMenuBuilder.cs" />
        <Compile Include="..\SHARED\NeoUI\NeoIconButton.cs"
                 Link="Shared\NeoUI\NeoIconButton.cs" />
        <Compile Include="..\SHARED\NeoUI\NeoTitleBar.xaml.cs"
                 Link="Shared\NeoUI\NeoTitleBar.xaml.cs">
            <DependentUpon>NeoTitleBar.xaml</DependentUpon>
        </Compile>

        <Page Include="..\SHARED\NeoUI\NeoTitleBar.xaml"
              Link="Shared\NeoUI\NeoTitleBar.xaml" />
        <Page Include="..\SHARED\NeoUI\NeoMenuStyles.xaml"
              Link="Shared\NeoUI\NeoMenuStyles.xaml" />
        <Page Include="..\SHARED\NeoUI\NeoToolBarStyles.xaml"
              Link="Shared\NeoUI\NeoToolBarStyles.xaml" />
        <Page Include="..\SHARED\NeoUI\NeoWindowStyles.xaml"
              Link="Shared\NeoUI\NeoWindowStyles.xaml" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Tests\**\*.cs" />

        <ApplicationDefinition Include="Sources\App.xaml" />

        <Resource Include="Resources\app.ico" />

        <Content Include="ThirdParty\CoreJ2K\LICENSE"
                 CopyToOutputDirectory="PreserveNewest" />
        <Content Include="ThirdParty\CoreJ2K\COPYRIGHT-JJ2000-5.1"
                 CopyToOutputDirectory="PreserveNewest" />

        <Resource Include="..\SHARED\Flags\Assets\**\*.png">
            <Link>Shared\Flags\Assets\%(Filename)%(Extension)</Link>
        </Resource>
        <Resource Include="..\SHARED\NeoUI\Assets\**\*.png">
            <Link>Shared\NeoUI\Assets\%(Filename)%(Extension)</Link>
        </Resource>

        <EmbeddedResource Include="..\SHARED\Book\Formats\Pdf\Resources\CMaps\*"
                          Exclude="..\SHARED\Book\Formats\Pdf\Resources\CMaps\*.md">
            <LogicalName>Book.Formats.Pdf.CMaps.%(Filename)</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="..\SHARED\Book\Formats\Pdf\Resources\CidToUnicode\Adobe-*-UCS2">
            <LogicalName>Book.Formats.Pdf.CidToUnicode.%(Filename)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CoreJ2K"
                          Version="2.4.1.108" />
        <PackageReference Include="Markdig"
                          Version="1.4.0" />
        <PackageReference Include="Microsoft.Web.WebView2"
                          Version="1.0.4258.31" />
    </ItemGroup>

</Project>
