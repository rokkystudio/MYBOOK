<Window x:Class="MYBOOK.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:neo="clr-namespace:NeoUI"
        Title="Settings"
        Style="{StaticResource NeoFixedWindowStyle}"
        Width="660"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <neo:NeoTitleBar x:Name="TitleBar"
                             Grid.Row="0"
                             TitleText="Settings"
                             SubtitleText="MYBOOK"
                             VersionText="1.0.35"
                             ShowIcon="True"
                             ShowLanguageButton="False"
                             ShowThemeButton="False"
                             ShowSettingsButton="False"
                             ShowMinimizeButton="False"
                             ShowMaximizeButton="False"
                             ShowCloseButton="True"
                             EnableDoubleClickMaximize="False"
                             CloseClick="CloseButton_OnClick" />

            <TabControl x:Name="Tabs"
                        Grid.Row="1"
                        Margin="12"
                        Background="{DynamicResource BackgroundBrush}"
                        Foreground="{DynamicResource TextBrush}">
                <TabItem x:Name="FileFormatsTab">
                    <Border Padding="18"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="FileFormatsDescriptionText"
                                       Grid.Row="0"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="FileFormatsPanel" />
                            </ScrollViewer>

                            <StackPanel Grid.Row="2"
                                        Margin="0,14,0,0">
                                <TextBlock x:Name="AssociationStatusText"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <Button x:Name="WindowsDefaultsButton"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource NeoToolBarButtonStyle}"
                                        Click="WindowsDefaultsButton_OnClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
