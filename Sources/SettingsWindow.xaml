<Window x:Class="MYBOOK.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:neo="clr-namespace:NeoUI"
        Title="Settings"
        Style="{StaticResource NeoFixedWindowStyle}"
        Width="660"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <neo:NeoTitleBar x:Name="TitleBar"
                             Grid.Row="0"
                             TitleText="Settings"
                             SubtitleText="MYBOOK"
                             VersionText="1.0.23"
                             ShowIcon="True"
                             ShowLanguageButton="False"
                             ShowThemeButton="False"
                             ShowSettingsButton="False"
                             ShowMinimizeButton="False"
                             ShowMaximizeButton="False"
                             ShowCloseButton="True"
                             EnableDoubleClickMaximize="False"
                             CloseClick="CloseButton_OnClick" />

            <TabControl x:Name="Tabs"
                        Grid.Row="1"
                        Margin="12"
                        Background="{DynamicResource BackgroundBrush}"
                        Foreground="{DynamicResource TextBrush}">
                <TabItem x:Name="FileFormatsTab">
                    <Border Padding="18"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="FileFormatsDescriptionText"
                                       Grid.Row="0"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <CheckBox x:Name="Fb2AssociationCheckBox"
                                              Tag=".fb2"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".fb2 — FictionBook 2" />

                                    <CheckBox x:Name="EpubAssociationCheckBox"
                                              Tag=".epub"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".epub — EPUB" />

                                    <CheckBox x:Name="HtmlAssociationCheckBox"
                                              Tag=".html"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".html — HTML" />

                                    <CheckBox x:Name="HtmAssociationCheckBox"
                                              Tag=".htm"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".htm — HTML" />

                                    <CheckBox x:Name="TxtAssociationCheckBox"
                                              Tag=".txt"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".txt — Text" />

                                    <CheckBox x:Name="MarkdownAssociationCheckBox"
                                              Tag=".md"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".md — Markdown" />

                                    <CheckBox x:Name="RtfAssociationCheckBox"
                                              Tag=".rtf"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".rtf — Rich Text Format" />

                                    <CheckBox x:Name="DocAssociationCheckBox"
                                              Tag=".doc"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".doc — Microsoft Word Binary" />

                                    <CheckBox x:Name="PdfAssociationCheckBox"
                                              Tag=".pdf"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".pdf — PDF" />

                                    <CheckBox x:Name="DocxAssociationCheckBox"
                                              Tag=".docx"
                                              Margin="0,0,0,12"
                                              FontSize="14"
                                              Checked="AssociationCheckBox_OnChanged"
                                              Unchecked="AssociationCheckBox_OnChanged"
                                              Content=".docx — Word OpenXML" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2"
                                        Margin="0,14,0,0">
                                <TextBlock x:Name="AssociationStatusText"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <Button x:Name="WindowsDefaultsButton"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource NeoToolBarButtonStyle}"
                                        Click="WindowsDefaultsButton_OnClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
