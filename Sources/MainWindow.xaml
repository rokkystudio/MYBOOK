<Window x:Class="MYBOOK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:neo="clr-namespace:NeoUI"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MYBOOK"
        Style="{StaticResource NeoResizableWindowStyle}"
        Width="900"
        Height="720"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        Loaded="MainWindow_OnLoaded">
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <neo:NeoTitleBar x:Name="TitleBar"
                             Grid.Row="0"
                             TitleText="MYBOOK"
                             SubtitleText="Document Reader"
                             VersionText="1.0.35"
                             ShowIcon="True"
                             ShowLanguageButton="False"
                             ShowThemeButton="False"
                             ShowSettingsButton="False"
                             ShowMinimizeButton="True"
                             ShowMaximizeButton="True"
                             ShowCloseButton="True"
                             EnableDoubleClickMaximize="True"
                             CloseClick="CloseButton_OnClick" />

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal">
                        <Button x:Name="OpenButton"
                                Style="{StaticResource NeoToolBarButtonStyle}"
                                Click="OpenButton_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂"
                                           Margin="0,0,7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="OpenButtonText"
                                           Text="Открыть"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavigationButton"
                                Margin="6,0,0,0"
                                IsEnabled="False"
                                Style="{StaticResource NeoToolBarButtonStyle}"
                                Click="NavigationButton_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☰"
                                           Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           FontSize="16" />
                                <TextBlock x:Name="NavigationButtonText"
                                           Text="Навигация"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource NeoToolBarIconButtonStyle}"
                                Click="SettingsButton_OnClick">
                            <Image x:Name="SettingsIcon"
                                   Width="20"
                                   Height="20"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="Fant" />
                        </Button>

                        <Separator Style="{StaticResource NeoToolBarSeparatorStyle}" />

                        <Button x:Name="LanguageToolButton"
                                Style="{StaticResource NeoToolBarIconButtonStyle}"
                                Click="LanguageButton_OnClick">
                            <Image x:Name="LanguageIcon"
                                   Width="24"
                                   Height="18"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="Fant" />
                        </Button>

                        <Button x:Name="ThemeToolButton"
                                Style="{StaticResource NeoToolBarIconButtonStyle}"
                                Click="ThemeButton_OnClick">
                            <Image x:Name="ThemeIcon"
                                   Width="20"
                                   Height="20"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="Fant" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="NavigationPanel"
                        Grid.Column="0"
                        Width="280"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="8,8,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ContentsModeButton"
                                    Grid.Column="0"
                                    Margin="0,0,3,0"
                                    Style="{StaticResource NeoToolBarButtonStyle}"
                                    Click="ContentsModeButton_OnClick">
                                <TextBlock x:Name="ContentsModeButtonText"
                                           Text="Оглавление"
                                           HorizontalAlignment="Center" />
                            </Button>

                            <Button x:Name="PagesModeButton"
                                    Grid.Column="1"
                                    Margin="3,0,0,0"
                                    Style="{StaticResource NeoToolBarButtonStyle}"
                                    Click="PagesModeButton_OnClick">
                                <TextBlock x:Name="PagesModeButtonText"
                                           Text="Страницы"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <TreeView x:Name="OutlineTree"
                                      Margin="6,0,6,8"
                                      Padding="2"
                                      BorderThickness="0"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource TextBrush}"
                                      SelectedItemChanged="OutlineTree_OnSelectedItemChanged" />

                            <Grid x:Name="PagesPanel"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="10,2,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="PageJumpLabelText"
                                               Grid.Column="0"
                                               Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               Text="Страница" />

                                    <TextBox x:Name="PageNumberTextBox"
                                             Grid.Column="1"
                                             Height="28"
                                             Padding="6,3"
                                             VerticalContentAlignment="Center"
                                             Text="1"
                                             KeyDown="PageNumberTextBox_OnKeyDown" />

                                    <TextBlock x:Name="PageCountTextBlock"
                                               Grid.Column="2"
                                               Margin="6,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="/ 0" />

                                    <Button x:Name="GoToPageButton"
                                            Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource NeoToolBarButtonStyle}"
                                            Click="GoToPageButton_OnClick">
                                        <TextBlock x:Name="GoToPageButtonText"
                                                   Text="Перейти" />
                                    </Button>
                                </Grid>

                                <ListBox x:Name="PagePreviewList"
                                         Grid.Row="1"
                                         Margin="4,0,4,8"
                                         BorderThickness="0"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         SelectionChanged="PagePreviewList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6"
                                                    Padding="7"
                                                    Background="{DynamicResource RaisedSurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                <StackPanel>
                                                    <Border HorizontalAlignment="Center"
                                                            Background="White"
                                                            BorderBrush="#C8CCD2"
                                                            BorderThickness="1">
                                                        <Viewbox Width="150"
                                                                 MaxHeight="210"
                                                                 Stretch="Uniform">
                                                            <Canvas Width="{Binding PreviewWidth}"
                                                                    Height="{Binding PreviewHeight}"
                                                                    Background="White"
                                                                    Loaded="PagePreviewCanvas_OnLoaded"
                                                                    Unloaded="PagePreviewCanvas_OnUnloaded" />
                                                        </Viewbox>
                                                    </Border>

                                                    <TextBlock Margin="0,7,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontFamily="Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Text="{Binding PageNumber}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter x:Name="NavigationSplitter"
                              Grid.Column="1"
                              Width="4"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext" />

                <Grid Grid.Column="2">
                    <TextBlock x:Name="EmptyStateTextBlock"
                               Margin="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Open a supported document to start reading."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <wv2:WebView2 x:Name="Reader"
                                  Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <Window.InputBindings>
        <KeyBinding Key="O"
                    Modifiers="Control"
                    Command="{x:Static ApplicationCommands.Open}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}"
                        Executed="OpenCommand_OnExecuted" />
    </Window.CommandBindings>
</Window>
